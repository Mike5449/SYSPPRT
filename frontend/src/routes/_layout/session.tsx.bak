import {
  Badge,
  Box,
  Container,
  EmptyState,
  Flex,
  Heading,
  HStack,
  Icon,
  IconButton,
  Input,
  Table,
  Text,
  VStack,
} from "@chakra-ui/react"
import { useQuery, useQueryClient } from "@tanstack/react-query"
import { createFileRoute, useNavigate } from "@tanstack/react-router"
import { useEffect, useState } from "react"
import { useTranslation } from "react-i18next"
import {
  FiActivity,
  FiBook,
  FiCalendar,
  FiChevronDown,
  FiClock,
  FiRefreshCw,
  FiSearch,
} from "react-icons/fi"
import { MenuContent, MenuItem, MenuRoot, MenuTrigger } from "@/components/ui/menu"
import { z } from "zod"

import { SessionsService } from "@/client"
import { SessionActionsMenu } from "@/components/Common/SessionActionsMenu"
import PendingItems from "@/components/Pending/PendingItems"
import AddSession from "@/components/session/AddSession"
import {
  PaginationItems,
  PaginationNextTrigger,
  PaginationPrevTrigger,
  PaginationRoot,
} from "@/components/ui/pagination"

const sessionSearchSchema = z.object({
  page: z.number().catch(1),
  code: z.string().optional(),
  academicYearId: z.string().optional(),
  is_active: z.string().optional(),
})

const PER_PAGE = 10

function getSessionsQueryOptions({
  page,
  code,
  academicYearId,
  is_active,
}: {
  page: number
  code?: string
  academicYearId?: string
  is_active?: string
}) {
  return {
    queryFn: () =>
      SessionsService.readSessionsWithAcademicYear({
        skip: (page - 1) * PER_PAGE,
        limit: PER_PAGE,
        code: code || undefined,
        academicYearId: academicYearId || undefined,
        isActive:
          is_active === "yes" ? true : is_active === "no" ? false : undefined,
      }),
    queryKey: ["sessions", { page, code, academicYearId, is_active }],
  }
}

export const Route = createFileRoute("/_layout/session")({
  component: SessionPage,
  validateSearch: (search) => sessionSearchSchema.parse(search),
})

function SessionHeader({
  codeSearch,
  setCodeSearch,
  isActiveFilter,
  setIsActiveFilter,
}: {
  codeSearch: string
  setCodeSearch: (v: string) => void
  isActiveFilter: string
  setIsActiveFilter: (v: string) => void
}) {
  const { t } = useTranslation()
  const queryClient = useQueryClient()
  const navigate = useNavigate({ from: Route.fullPath })


  const handleRefresh = () => {
    queryClient.invalidateQueries({ queryKey: ["sessions"] })
  }

  return (
    <Box mb={4}>
      <Flex justify="space-between" align="center" mb={3}>
        <Box>
          <Heading size="lg" fontSize="lg" fontWeight="bold" color="gray.800" mb={0.5}>
            Sessions Académiques
          </Heading>
          <Text color="fg.muted" fontSize="sm">
            {t("session.description", { defaultValue: "Gérer les sessions et trimestres académiques" })}
          </Text>
        </Box>
        <HStack gap={2}>
          <IconButton variant="ghost" size="xs" color="#6b8ab0" onClick={handleRefresh} aria-label={t("common.tables.refresh")} _hover={{ color: "ui.main", bg: "transparent" }}>
            <FiRefreshCw />
          </IconButton>
          <AddSession />
        </HStack>
      </Flex>
      <HStack bg="white" borderRadius="8px" p="0.35rem 1rem" boxShadow="0 2px 8px rgba(0,20,40,0.04)" border="1px solid #edf2f7" gap="10px" w="full" justify="flex-end">
        <Icon as={FiSearch} color="#a0aec0" boxSize={3} />
        <Input border="none" bg="transparent" placeholder={t("session.fields.code")} fontSize="0.75rem" w="140px" size="sm" outline="none" _focus={{ outline: "none", boxShadow: "none" }} value={codeSearch} onChange={(e) => setCodeSearch(e.target.value)} />
        <Box w="1px" h="10px" bg="gray.100" />
        <MenuRoot positioning={{ gutter: 4, placement: "bottom-end" }}>
          <MenuTrigger asChild>
            <HStack cursor="pointer" color="#1f3b62" fontWeight="500" fontSize="0.75rem" _hover={{ color: "ui.main" }} gap="4px">
              <Icon as={FiActivity} color="#2a5f8a" boxSize={3} />
              <Text>{isActiveFilter === "yes" ? t("common.tables.active", { defaultValue: "Active" }) : isActiveFilter === "no" ? t("common.tables.inactive", { defaultValue: "Inactive" }) : t("common.tables.all_status", { defaultValue: "Statut" })}</Text>
              <Icon as={FiChevronDown} boxSize={2.5} color="#a0aec0" />
            </HStack>
          </MenuTrigger>
          <MenuContent minW="120px" bg="white" borderRadius="10px" border="1px solid #e2ecf9" p="4px" zIndex={1500}>
            <MenuItem value="" fontSize="0.75rem" borderRadius="6px" onClick={() => { setIsActiveFilter(""); navigate({ to: "/session", search: (prev) => ({ ...prev, is_active: undefined, page: 1 }) }) }}>{t("common.tables.all_status", { defaultValue: "Tous" })}</MenuItem>
            <MenuItem value="yes" fontSize="0.75rem" borderRadius="6px" onClick={() => { setIsActiveFilter("yes"); navigate({ to: "/session", search: (prev) => ({ ...prev, is_active: "yes", page: 1 }) }) }}>{t("common.tables.active", { defaultValue: "Active" })}</MenuItem>
            <MenuItem value="no" fontSize="0.75rem" borderRadius="6px" onClick={() => { setIsActiveFilter("no"); navigate({ to: "/session", search: (prev) => ({ ...prev, is_active: "no", page: 1 }) }) }}>{t("common.tables.inactive", { defaultValue: "Inactive" })}</MenuItem>
          </MenuContent>
        </MenuRoot>
      </HStack>
    </Box>
  )
}

function SessionTable({ codeSearch }: { codeSearch: string }) {
  const { t } = useTranslation()
  const navigate = useNavigate({ from: Route.fullPath })
  const { page, academicYearId, is_active } = Route.useSearch()
  const code = codeSearch

  // Sync debounced code search to URL
  useEffect(() => {
    const timer = setTimeout(() => {
      navigate({ to: "/session", search: (prev) => ({ ...prev, code: codeSearch || undefined, page: 1 }) })
    }, 500)
    return () => clearTimeout(timer)
  }, [codeSearch]) // eslint-disable-line react-hooks/exhaustive-deps

  const { data, isLoading, isPlaceholderData } = useQuery({
    ...getSessionsQueryOptions({ page, code, academicYearId, is_active }),
    placeholderData: (prevData) => prevData,
  })

  const setPage = (page: number) => {
    navigate({
      to: "/session",
      search: (prev) => ({ ...prev, page }),
    })
  }

  const sessions = data?.data?.slice(0, PER_PAGE) ?? []
  const count = data?.count ?? 0

  if (isLoading) {
    return <PendingItems />
  }

  if (sessions.length === 0) {
    return (
      <Box
        py={12}
        bg="white"
        borderRadius="xl"
        border="1px solid"
        borderColor="gray.200"
      >
        <EmptyState.Root>
          <EmptyState.Content>
            <EmptyState.Indicator>
              <FiSearch size="48px" />
            </EmptyState.Indicator>
            <VStack textAlign="center" gap={2}>
              <EmptyState.Title
                fontSize="sm"
                color="gray.800"
                fontWeight="bold"
              >
                {t("common.tables.no_results")}
              </EmptyState.Title>
              <EmptyState.Description color="gray.500" fontSize="xs">
                {t("session.add_description", {
                  defaultValue: "Get started by adding your first session",
                })}
              </EmptyState.Description>
            </VStack>
          </EmptyState.Content>
        </EmptyState.Root>
      </Box>
    )
  }

  const formatDate = (dateString: string) => {
    try {
      return new Date(dateString).toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
      })
    } catch {
      return dateString
    }
  }

  return (
    <VStack align="stretch" gap={4}>
      <Box
        bg="white"
        borderRadius="sm"
        border="1px solid"
        borderColor="gray.200"
        overflowX="auto"
      >
        <Table.Root size="sm" interactive stickyHeader minW="1000px">
          <Table.Header
          >
            <Table.Row background="linear-gradient(135deg, #2c5282 0%, #2b6cb0 100%)">
              <Table.ColumnHeader
                w="180px"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("common.tables.name")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="100px"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("session.fields.code")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="80px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("session.fields.number")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="240px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("common.tables.duration")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                flex="1"
                minW="150px"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("session.fields.description")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="140px"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("session.fields.academic_year")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="100px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("common.tables.status")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="80px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("common.tables.actions")}
              </Table.ColumnHeader>
            </Table.Row>
          </Table.Header>

          <Table.Body>
            {sessions.map((session) => {
              const isActive = session.is_active

              return (
                <Table.Row
                  key={session.id}
                  opacity={isPlaceholderData ? 0.5 : 1}
                  _odd={{ bg: "#f7f9fc" }} _even={{ bg: "white" }} _hover={{ bg: "gray.100" }}
                >
                  <Table.Cell w="180px">
                    <HStack gap={2}>
                      <Icon as={FiCalendar} color="gray.400" size="xs" />
                      <Text
                        fontSize="sm"
                        color="gray.800"
                        fontWeight="600"
                        truncate
                      >
                        {session.name}
                      </Text>
                    </HStack>
                  </Table.Cell>

                  <Table.Cell w="100px">
                    <Badge colorPalette="purple" variant="surface" size="xs">
                      {session.code}
                    </Badge>
                  </Table.Cell>

                  <Table.Cell w="80px" textAlign="center">
                    <Text
                      fontSize="xs"
                      color="gray.600"
                      fontFamily="mono"
                      fontWeight="bold"
                    >
                      {session.session_number}
                    </Text>
                  </Table.Cell>

                  <Table.Cell w="240px" textAlign="center">
                    <HStack gap={1} justify="center">
                      <Icon as={FiClock} size="xs" color="gray.400" />
                      <Text
                        fontSize="xs"
                        color="gray.600"
                        fontWeight="medium"
                        whiteSpace="nowrap"
                      >
                        {formatDate(session.start_date)} -{" "}
                        {formatDate(session.end_date)}
                      </Text>
                    </HStack>
                  </Table.Cell>

                  <Table.Cell flex="1" minW="150px">
                    <Text
                      fontSize="xs"
                      color="black"
                      truncate
                      title={session.description || undefined}
                    >
                      {session.description || "-"}
                    </Text>
                  </Table.Cell>

                  <Table.Cell w="140px">
                    <HStack gap={1}>
                      <Icon as={FiBook} boxSize={3} color="gray.400" />
                      <Text
                        fontSize="xs"
                        color="gray.700"
                        truncate
                        title={session.academic_year?.name}
                      >
                        {session.academic_year?.name || "-"}
                      </Text>
                    </HStack>
                  </Table.Cell>

                  <Table.Cell w="100px" textAlign="center">
                    {isActive ? (
                      <Badge colorPalette="green" variant="subtle" size="xs">
                        {t("common.tables.active")}
                      </Badge>
                    ) : (
                      <Badge colorPalette="red" variant="subtle" size="xs">
                        {t("common.tables.inactive")}
                      </Badge>
                    )}
                  </Table.Cell>

                  <Table.Cell w="80px" textAlign="center">
                    <SessionActionsMenu session={session} />
                  </Table.Cell>
                </Table.Row>
              )
            })}
          </Table.Body>
        </Table.Root>
      </Box>

      {/* Pagination - Always visible */}
      <Flex justify="space-between" align="center" mt={2} px={1}>
        <Text fontSize="xs" color="gray.500">
          {t("common.tables.showing", {
            first: (page - 1) * PER_PAGE + 1,
            last: Math.min(page * PER_PAGE, count),
            total: count,
            items: t("common.sessions"),
          })}
        </Text>

        <PaginationRoot
          count={count}
          pageSize={PER_PAGE}
          page={page}
          onPageChange={({ page }) => setPage(page)}
        >
          <HStack gap={1}>
            <PaginationPrevTrigger />
            <PaginationItems />
            <PaginationNextTrigger />
          </HStack>
        </PaginationRoot>
      </Flex>
    </VStack>
  )
}

function SessionPage() {
  const search = Route.useSearch()
  const [codeSearch, setCodeSearch] = useState(search.code || "")
  const [isActiveFilter, setIsActiveFilter] = useState(search.is_active || "")

  return (
    <Container maxW="full" py={8}>
      <SessionHeader
        codeSearch={codeSearch}
        setCodeSearch={setCodeSearch}
        isActiveFilter={isActiveFilter}
        setIsActiveFilter={setIsActiveFilter}
      />
      <SessionTable codeSearch={codeSearch} />
    </Container>
  )
}
