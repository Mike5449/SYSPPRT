import {
  Badge,
  Box,
  Container,
  EmptyState,
  Flex,
  Heading,
  HStack,
  Icon,
  IconButton,
  Input,
  Table,
  Text,
  VStack,
} from "@chakra-ui/react"
import { useQuery, useQueryClient } from "@tanstack/react-query"
import { createFileRoute, useNavigate } from "@tanstack/react-router"
import { useEffect, useState } from "react"
import { useTranslation } from "react-i18next"
import {
  FiAlertCircle,
  FiBookOpen,
  FiCalendar,
  FiFileText,
  FiFilter,
  FiChevronDown,
  FiGift,
  FiHash,
  FiMapPin,
  FiPhone,
  FiRefreshCw,
  FiSearch,
  FiUser,
} from "react-icons/fi"
import { z } from "zod"
import { MenuContent, MenuItem, MenuRoot, MenuTrigger } from "@/components/ui/menu"

import { StudentsService } from "@/client"
import { StudentActionsMenu } from "@/components/Common/StudentActionsMenu"
import PendingItems from "@/components/Pending/PendingItems"
import AddStudentWithUser from "@/components/student/AddStudentWithUser"
import {
  PaginationItems,
  PaginationNextTrigger,
  PaginationPrevTrigger,
  PaginationRoot,
} from "@/components/ui/pagination.tsx"

const studentSearchSchema = z.object({
  page: z.number().catch(1),
  q: z.string().optional(),
  yearLevel: z.number().optional(),
  programId: z.string().optional(),
  programLevelId: z.string().optional(),
  scholarshipType: z.string().optional(),
})

const PER_PAGE = 10

function getStudentsQueryOptions({
  page,
  q,
  yearLevel,
  programId,
  programLevelId,
  scholarshipType
}: {
  page: number,
  q?: string,
  yearLevel?: number,
  programId?: string,
  programLevelId?: string,
  scholarshipType?: string
}) {
  return {
    queryFn: () =>
      StudentsService.readStudents({
        skip: (page - 1) * PER_PAGE,
        limit: PER_PAGE,
        q: q || undefined,
        yearLevel: yearLevel || undefined,
        programId: programId || undefined,
        programLevelId: programLevelId || undefined,
        scholarshipType: scholarshipType || undefined,
      }),
    queryKey: ["students", { page, q, yearLevel, programId, programLevelId, scholarshipType }],
  }
}

export const Route = createFileRoute("/_layout/student")({
  component: Students,
  validateSearch: (search) => studentSearchSchema.parse(search),
})

function StudentsHeader({
  searchTerm,
  setSearchTerm,
  yearLevelValue,
  onYearLevelChange,
}: {
  searchTerm: string
  setSearchTerm: (v: string) => void
  yearLevelValue: string
  onYearLevelChange: (v: string) => void
}) {
  const { t } = useTranslation()
  const queryClient = useQueryClient()


  const handleRefresh = () => {
    queryClient.invalidateQueries({ queryKey: ["students"] })
  }

  return (
    <Box mb={4}>
      <Flex justify="space-between" align="center" mb={3}>
        <Box>
          <Heading fontSize="lg" fontWeight="bold" color="gray.800" mb={0.5}>
            Gestion des Étudiants
          </Heading>
          <Text color="fg.muted" fontSize="sm">
            {t("common.tables.description_student")}
          </Text>
        </Box>
        <HStack gap={2}>
          <IconButton variant="ghost" size="xs" color="#6b8ab0" onClick={handleRefresh} aria-label={t("common.tables.refresh")} _hover={{ color: "ui.main", bg: "transparent" }}>
            <FiRefreshCw />
          </IconButton>
          <AddStudentWithUser />
        </HStack>
      </Flex>
      <HStack bg="white" borderRadius="8px" p="0.35rem 1rem" boxShadow="0 2px 8px rgba(0,20,40,0.04)" border="1px solid #edf2f7" gap="10px" w="full" justify="flex-end">
        <Icon as={FiSearch} color="#a0aec0" boxSize={3} />
        <Input border="none" bg="transparent" placeholder={t("common.tables.search_student")} fontSize="0.75rem" w="150px" size="sm" outline="none" _focus={{ outline: "none", boxShadow: "none" }} value={searchTerm} onChange={(e) => setSearchTerm(e.target.value)} />
        <Box w="1px" h="10px" bg="gray.100" />
        <MenuRoot positioning={{ gutter: 4, placement: "bottom-end" }}>
          <MenuTrigger asChild>
            <HStack cursor="pointer" color="#1f3b62" fontWeight="500" fontSize="0.75rem" _hover={{ color: "ui.main" }} gap="4px">
              <Icon as={FiFilter} color="#2a5f8a" boxSize={3} />
              <Text>{yearLevelValue ? t("common.tables.year_level", { level: yearLevelValue, defaultValue: `An ${yearLevelValue}` }) : t("common.tables.all_years")}</Text>
              <Icon as={FiChevronDown} boxSize={2.5} color="#a0aec0" />
            </HStack>
          </MenuTrigger>
          <MenuContent minW="130px" bg="white" borderRadius="10px" border="1px solid #e2ecf9" p="4px" zIndex={1500}>
            <MenuItem value="" fontSize="0.75rem" borderRadius="6px" onClick={() => onYearLevelChange("")}>{t("common.tables.all_years")}</MenuItem>
            {[1, 2, 3, 4, 5].map((level) => (
              <MenuItem key={level} value={level.toString()} fontSize="0.75rem" borderRadius="6px" onClick={() => onYearLevelChange(level.toString())}>
                {t("common.tables.year_level", { level, defaultValue: `An ${level}` })}
              </MenuItem>
            ))}
          </MenuContent>
        </MenuRoot>
      </HStack>
    </Box>
  )
}


function StudentsTable({ searchTerm }: { searchTerm: string }) {
  const { t } = useTranslation()
  const navigate = useNavigate({ from: Route.fullPath })
  const search = Route.useSearch()
  const { page } = search

  // Sync debounced search to URL
  useEffect(() => {
    const timer = setTimeout(() => {
      navigate({ to: "/student", search: (prev) => ({ ...prev, q: searchTerm || undefined, page: 1 }) })
    }, 500)
    return () => clearTimeout(timer)
  }, [searchTerm]) // eslint-disable-line react-hooks/exhaustive-deps

  const { data, isLoading, isPlaceholderData } = useQuery({
    ...getStudentsQueryOptions(search),
    placeholderData: (prevData) => prevData,
  })

  const setPage = (page: number) => {
    navigate({
      to: "/student",
      search: (prev) => ({ ...prev, page }),
    })
  }

  const students = data?.data?.slice(0, PER_PAGE) ?? []
  const count = data?.count ?? 0

  if (isLoading) {
    return <PendingItems />
  }

  if (students.length === 0) {
    return (
      <Box
        py={12}
        bg="white"
        borderRadius="sm"
        border="1px solid"
        borderColor="gray.200"
      >
        <EmptyState.Root>
          <EmptyState.Content>
            <EmptyState.Indicator>
              <FiSearch size="48px" />
            </EmptyState.Indicator>
            <VStack textAlign="center" gap={2}>
              <EmptyState.Title
                fontSize="sm"
                color="gray.800"
                fontWeight="bold"
              >
                {t("common.tables.no_results")}
              </EmptyState.Title>
              <EmptyState.Description color="gray.500" fontSize="xs">
                {t("common.tables.add_first_student", {
                  defaultValue: "Get started by enrolling your first student",
                })}
              </EmptyState.Description>
            </VStack>
          </EmptyState.Content>
        </EmptyState.Root>
      </Box>
    )
  }

  const formatDate = (dateString: string) => {
    try {
      return new Date(dateString).toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "2-digit",
      })
    } catch {
      return dateString
    }
  }

  const getStatusColor = (status: string | undefined) => {
    if (!status) return "gray"
    const statusLower = status.toLowerCase()
    if (statusLower.includes("active") || statusLower.includes("enrolled"))
      return "green"
    if (statusLower.includes("graduated")) return "blue"
    if (statusLower.includes("suspended") || statusLower.includes("inactive"))
      return "red"
    if (statusLower.includes("probation")) return "orange"
    return "gray"
  }

  // const _getGPAColor = ...

  return (
    <VStack align="stretch" gap={4}>
      <Box
        bg="white"
        borderRadius="sm"
        border="1px solid"
        borderColor="gray.200"
        overflowX="auto"
      >
        <Table.Root size="sm" interactive stickyHeader minW="1300px">
          <Table.Header>
            <Table.Row background="linear-gradient(135deg, #2c5282 0%, #2b6cb0 100%)">
              <Table.ColumnHeader
                w="200px"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                // textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("common.tables.student_info")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="120px"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                // textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("common.tables.student_number")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="80px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                letterSpacing="wider"
              >
                {t("common.tables.sex")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="120px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                letterSpacing="wider"
              >
                {t("common.tables.dob")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="120px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                letterSpacing="wider"
              >
                {t("common.tables.admission")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="100px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                letterSpacing="wider"
              >
                {t("common.tables.status")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="80px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                letterSpacing="wider"
              >
                {t("common.tables.year")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="180px"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                letterSpacing="wider"
              >
                {t("common.tables.contact")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="180px"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                letterSpacing="wider"
              >
                {t("common.tables.emergency")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="100px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                letterSpacing="wider"
              >
                {t("common.tables.scholarship")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                flex="1"
                minW="200px"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                letterSpacing="wider"
              >
                {t("common.tables.program_level")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="80px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                // textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("common.tables.actions")}
              </Table.ColumnHeader>
            </Table.Row>
          </Table.Header>

          <Table.Body>
            {students.map((student, _index) => (
              <Table.Row
                key={student.id}
                opacity={isPlaceholderData ? 0.5 : 1}
                _odd={{ bg: "#f7f9fc" }} _even={{ bg: "white" }} _hover={{ bg: "gray.100" }}
              >
                <Table.Cell w="200px">
                  <VStack align="start" gap={0}>
                    <HStack gap={2}>
                      <Icon as={FiUser} color="gray.400" size="xs" />
                      <Text
                        fontSize="sm"
                        color="gray.700"
                        fontWeight="600"
                        truncate
                        maxW="160px"
                        title={`${student.user?.first_name} ${student.user?.last_name}`}
                      >
                        {student.user
                          ? `${student.user.first_name} ${student.user.last_name}`
                          : "N/A"}
                      </Text>
                    </HStack>
                    <Text fontSize="xs" color="gray.500" truncate maxW="180px">
                      {student.user?.email || "N/A"}
                    </Text>
                  </VStack>
                </Table.Cell>

                <Table.Cell w="120px">
                  <HStack gap={1}>
                    <Icon as={FiHash} size="xs" color="gray.400" />
                    <Text
                      fontSize="xs"
                      color="gray.600"
                      fontFamily="mono"
                      fontWeight="600"
                    >
                      {student.user?.user_number || "-"}
                    </Text>
                  </HStack>
                </Table.Cell>

                <Table.Cell w="80px" textAlign="center">
                  <Badge colorPalette="gray" variant="subtle" size="xs">
                    {student.sex || "-"}
                  </Badge>
                </Table.Cell>

                <Table.Cell w="120px" textAlign="center">
                  <Text fontSize="xs" color="gray.600">
                    {student.date_of_birth ? formatDate(student.date_of_birth) : "-"}
                  </Text>
                </Table.Cell>

                <Table.Cell w="120px" textAlign="center">
                  <HStack gap={1} justify="center">
                    <Icon as={FiCalendar} size="xs" color="gray.400" />
                    <Text
                      fontSize="xs"
                      color="gray.600"
                      fontFamily="mono"
                      fontWeight="medium"
                    >
                      {formatDate(student.admission_date)}
                    </Text>
                  </HStack>
                </Table.Cell>

                <Table.Cell w="100px" textAlign="center">
                  <Badge
                    colorPalette={getStatusColor(student.status)}
                    variant="surface"
                    size="xs"
                  >
                    {student.status
                      ? t(`status.${student.status.toLowerCase()}`)
                      : t("common.tables.unknown")}
                  </Badge>
                </Table.Cell>

                <Table.Cell w="80px" textAlign="center">
                  <HStack gap={1} justify="center">
                    <Icon as={FiBookOpen} size="xs" color="gray.400" />
                    <Badge colorPalette="blue" variant="subtle" size="xs">
                      {student.current_year_level || 1}
                    </Badge>
                  </HStack>
                </Table.Cell>

                <Table.Cell w="180px">
                  <VStack align="start" gap={0}>
                    {student.phone_number && (
                      <HStack gap={1}>
                        <Icon as={FiPhone} size="xs" color="gray.400" />
                        <Text fontSize="xs" color="gray.600">
                          {student.phone_number}
                        </Text>
                      </HStack>
                    )}
                    {student.address && (
                      <HStack gap={1}>
                        <Icon as={FiMapPin} size="xs" color="gray.400" />
                        <Text fontSize="xs" color="gray.500" truncate maxW="160px" title={student.address}>
                          {student.address}
                        </Text>
                      </HStack>
                    )}
                  </VStack>
                </Table.Cell>

                <Table.Cell w="180px">
                  {student.emergency_contact_name ? (
                    <VStack align="start" gap={0}>
                      <HStack gap={1}>
                        <Icon as={FiAlertCircle} size="xs" color="red.400" />
                        <Text fontSize="xs" color="gray.700" fontWeight="600">
                          {student.emergency_contact_name}
                        </Text>
                      </HStack>
                      <Text fontSize="xs" color="gray.500">
                        {student.emergency_contact_phone} ({student.emergency_contact_relationship})
                      </Text>
                    </VStack>
                  ) : (
                    <Text fontSize="xs" color="gray.300">-</Text>
                  )}
                </Table.Cell>

                <Table.Cell w="100px" textAlign="center">
                  {student.is_scholarship ? (
                    <VStack gap={0}>
                      <HStack gap={1} justify="center">
                        <Icon as={FiGift} size="xs" color="orange.400" />
                        <Badge colorPalette="yellow" variant="solid" size="xs">
                          {t("common.tables.yes", { defaultValue: "Yes" })}
                        </Badge>
                      </HStack>
                      {student.scholarship_type && (
                        <Text
                          fontSize="xs"
                          color="gray.500"
                          truncate
                          maxW="80px"
                        >
                          {student.scholarship_type}
                        </Text>
                      )}
                    </VStack>
                  ) : (
                    <Text fontSize="xs" color="gray.300">
                      -
                    </Text>
                  )}
                </Table.Cell>

                <Table.Cell flex="1" minW="200px">
                  <VStack align="start" gap={0}>
                    <HStack gap={1}>
                      <Icon as={FiFileText} size="xs" color="blue.400" />
                      <Text
                        fontSize="xs"
                        color="gray.700"
                        fontWeight="600"
                        truncate
                        title={student.program_level?.program?.name}
                      >
                        {student.program_level?.program?.name || student.program_level?.name || "-"}
                      </Text>
                    </HStack>
                    <Text fontSize="xs" color="gray.500">
                      {student.program_level?.code} • {student.program_level?.program?.faculty?.name}
                    </Text>
                  </VStack>
                </Table.Cell>

                <Table.Cell w="80px" textAlign="center">
                  <StudentActionsMenu student={student} />
                </Table.Cell>
              </Table.Row>
            ))}
          </Table.Body>
        </Table.Root>
      </Box>

      {/* Pagination - Always visible */}
      <Flex justify="space-between" align="center" mt={2} px={1}>
        <Text fontSize="xs" color="gray.500">
          {t("common.tables.showing", {
            first: (page - 1) * PER_PAGE + 1,
            last: Math.min(page * PER_PAGE, count),
            total: count,
            items: t("common.students"),
          })}
        </Text>

        <PaginationRoot
          count={count}
          pageSize={PER_PAGE}
          page={page}
          onPageChange={({ page }) => setPage(page)}
        >
          <HStack gap={1}>
            <PaginationPrevTrigger />
            <PaginationItems />
            <PaginationNextTrigger />
          </HStack>
        </PaginationRoot>
      </Flex>
    </VStack>
  )
}

function Students() {
  const search = Route.useSearch()
  const navigate = useNavigate({ from: Route.fullPath })
  const [searchTerm, setSearchTerm] = useState(search.q || "")

  const updateYearLevel = (value: string) => {
    navigate({
      to: "/student",
      search: (prev) => ({
        ...prev,
        yearLevel: value ? parseInt(value, 10) : undefined,
        page: 1,
      }),
    })
  }

  return (
    <Container maxW="full" py={8}>
      <StudentsHeader
        searchTerm={searchTerm}
        setSearchTerm={setSearchTerm}
        yearLevelValue={search.yearLevel?.toString() ?? ""}
        onYearLevelChange={updateYearLevel}
      />
      <StudentsTable searchTerm={searchTerm} />
    </Container>
  )
}
