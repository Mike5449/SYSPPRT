import {
  Badge,
  Box,
  Container,
  EmptyState,
  Flex,
  Heading,
  HStack,
  Icon,
  IconButton,
  Input,
  Table,
  Text,
  VStack,
} from "@chakra-ui/react"
import { useQuery, useQueryClient } from "@tanstack/react-query"
import { createFileRoute, useNavigate } from "@tanstack/react-router"
import { useEffect, useState } from "react"
import { useTranslation } from "react-i18next"
import {
  FiActivity,
  FiBookOpen,
  FiChevronDown,
  FiClock,
  FiRefreshCw,
  FiSearch,
  FiUser,
} from "react-icons/fi"
import { MenuContent, MenuItem, MenuRoot, MenuTrigger } from "@/components/ui/menu"
import { z } from "zod"

import {
  CourseSessionsService,
} from "@/client"
import { CourseSessionActionsMenu } from "@/components/Common/CourseSessionActionsMenu"
import AddCourseSessionWithProgramNew from "@/components/course_session/AddCourseSessionWithProgram_NEW"
import PendingItems from "@/components/Pending/PendingItems"
import {
  PaginationItems,
  PaginationNextTrigger,
  PaginationPrevTrigger,
  PaginationRoot,
} from "@/components/ui/pagination.tsx"

const courseSessionSearchSchema = z.object({
  page: z.number().catch(1),
  course_query: z.string().optional(),
  program_id: z.string().optional(),
  program_level_id: z.string().optional(),
  teacher_id: z.string().optional(),
  session_id: z.string().optional(),
  status: z.string().optional(),
})

const PER_PAGE = 10

function getCourseSessionsQueryOptions({
  page,
  course_query,
  program_id,
  program_level_id,
  teacher_id,
  session_id,
  status,
}: {
  page: number
  course_query?: string
  program_id?: string
  program_level_id?: string
  teacher_id?: string
  session_id?: string
  status?: string
}) {
  return {
    queryFn: () =>
      CourseSessionsService.readCourseSessions({
        skip: (page - 1) * PER_PAGE,
        limit: PER_PAGE,
        courseQuery: course_query || undefined,
        programId: program_id || undefined,
        programLevelId: program_level_id || undefined,
        teacherId: teacher_id || undefined,
        sessionId: session_id || undefined,
        isActive:
          status === "active" ? true : status === "inactive" ? false : undefined,
      }),
    queryKey: [
      "course_sessions",
      {
        page,
        course_query,
        program_id,
        program_level_id,
        teacher_id,
        session_id,
        status,
      },
    ],
  }
}

export const Route = createFileRoute("/_layout/course_session")({
  component: CourseSessionPage,
  validateSearch: (search) => courseSessionSearchSchema.parse(search),
})

function CourseSessionHeader({
  courseSearch,
  setCourseSearch,
  statusFilter,
  setStatusFilter,
}: {
  courseSearch: string
  setCourseSearch: (v: string) => void
  statusFilter: string
  setStatusFilter: (v: string) => void
}) {
  const { t } = useTranslation()
  const queryClient = useQueryClient()
  const navigate = useNavigate({ from: Route.fullPath })


  const handleRefresh = () => {
    queryClient.invalidateQueries({ queryKey: ["course_sessions"] })
  }

  return (
    <Box mb={4}>
      <Flex justify="space-between" align="center" mb={3}>
        <Box>
          <Heading size="lg" fontSize="lg" fontWeight="bold" color="gray.800" mb={0.5}>
            Sessions de Cours
          </Heading>
          <Text color="fg.muted" fontSize="sm">
            {t("course.session.description")}
          </Text>
        </Box>
        <HStack gap={2}>
          <IconButton variant="ghost" size="xs" color="#6b8ab0" onClick={handleRefresh} aria-label={t("common.tables.refresh")} _hover={{ color: "ui.main", bg: "transparent" }}>
            <FiRefreshCw />
          </IconButton>
          <AddCourseSessionWithProgramNew />
        </HStack>
      </Flex>
      <HStack bg="white" borderRadius="8px" p="0.35rem 1rem" boxShadow="0 2px 8px rgba(0,20,40,0.04)" border="1px solid #edf2f7" gap="10px" w="full" justify="flex-end">
        <Icon as={FiSearch} color="#a0aec0" boxSize={3} />
        <Input border="none" bg="transparent" placeholder={t("common.tables.search_by_name_or_code")} fontSize="0.75rem" w="160px" size="sm" outline="none" _focus={{ outline: "none", boxShadow: "none" }} value={courseSearch} onChange={(e) => setCourseSearch(e.target.value)} />
        <Box w="1px" h="10px" bg="gray.100" />
        <MenuRoot positioning={{ gutter: 4, placement: "bottom-end" }}>
          <MenuTrigger asChild>
            <HStack cursor="pointer" color="#1f3b62" fontWeight="500" fontSize="0.75rem" _hover={{ color: "ui.main" }} gap="4px">
              <Icon as={FiActivity} color="#2a5f8a" boxSize={3} />
              <Text>{statusFilter === "active" ? t("course.session.table.active", { defaultValue: "Actif" }) : statusFilter === "inactive" ? t("course.session.table.inactive", { defaultValue: "Inactif" }) : t("common.tables.all_status", { defaultValue: "Statut" })}</Text>
              <Icon as={FiChevronDown} boxSize={2.5} color="#a0aec0" />
            </HStack>
          </MenuTrigger>
          <MenuContent minW="120px" bg="white" borderRadius="10px" border="1px solid #e2ecf9" p="4px" zIndex={1500}>
            <MenuItem value="" fontSize="0.75rem" borderRadius="6px" onClick={() => { setStatusFilter(""); navigate({ to: "/course_session", search: (prev) => ({ ...prev, status: undefined, page: 1 }) }) }}>{t("common.tables.all_status", { defaultValue: "Tous" })}</MenuItem>
            <MenuItem value="active" fontSize="0.75rem" borderRadius="6px" onClick={() => { setStatusFilter("active"); navigate({ to: "/course_session", search: (prev) => ({ ...prev, status: "active", page: 1 }) }) }}>{t("course.session.table.active", { defaultValue: "Actif" })}</MenuItem>
            <MenuItem value="inactive" fontSize="0.75rem" borderRadius="6px" onClick={() => { setStatusFilter("inactive"); navigate({ to: "/course_session", search: (prev) => ({ ...prev, status: "inactive", page: 1 }) }) }}>{t("course.session.table.inactive", { defaultValue: "Inactif" })}</MenuItem>
          </MenuContent>
        </MenuRoot>
      </HStack>
    </Box>
  )
}

function CourseSessionTable({ courseSearch }: { courseSearch: string }) {
  const { t } = useTranslation()
  const navigate = useNavigate({ from: Route.fullPath })
  const {
    page,
    program_id,
    program_level_id,
    teacher_id,
    session_id,
    status,
  } = Route.useSearch()
  const course_query = courseSearch

  // Sync debounced search to URL
  useEffect(() => {
    const timer = setTimeout(() => {
      navigate({ to: "/course_session", search: (prev) => ({ ...prev, course_query: courseSearch || undefined, page: 1 }) })
    }, 500)
    return () => clearTimeout(timer)
  }, [courseSearch]) // eslint-disable-line react-hooks/exhaustive-deps

  const { data, isLoading, isPlaceholderData } = useQuery({
    ...getCourseSessionsQueryOptions({
      page,
      course_query,
      program_id,
      program_level_id,
      teacher_id,
      session_id,
      status,
    }),
    placeholderData: (prevData) => prevData,
  })

  const setPage = (page: number) => {
    navigate({
      to: "/course_session",
      search: (prev) => ({ ...prev, page }),
    })
  }

  const sessions = data?.data?.slice(0, PER_PAGE) ?? []
  const count = data?.count ?? 0

  if (isLoading) {
    return <PendingItems />
  }

  if (sessions.length === 0) {
    return (
      <Box
        py={12}
        bg="white"
        borderRadius="4px"
        border="1px solid"
        borderColor="gray.200"
      >
        <EmptyState.Root>
          <EmptyState.Content>
            <EmptyState.Indicator>
              <FiSearch size="48px" />
            </EmptyState.Indicator>
            <VStack textAlign="center" gap={2}>
              <EmptyState.Title
                fontSize="sm"
                color="gray.800"
                fontWeight="bold"
              >
                {t("course.session.empty.title")}
              </EmptyState.Title>
              <EmptyState.Description color="gray.500" fontSize="xs">
                {t("course.session.empty.description")}
              </EmptyState.Description>
            </VStack>
          </EmptyState.Content>
        </EmptyState.Root>
      </Box>
    )
  }

  return (
    <VStack align="stretch" gap={4}>
      <Box
        bg="white"
        borderRadius="sm"
        border="1px solid"
        borderColor="gray.200"
        overflowX="auto"
      >
        <Table.Root size="sm" interactive stickyHeader minW="1400px">
          <Table.Header>
            <Table.Row background="linear-gradient(135deg, #2c5282 0%, #2b6cb0 100%)">
              <Table.ColumnHeader
                w="180px"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("course.session.table.course")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="150px"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("course.session.table.program")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="80px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("course.session.table.year_level")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="120px"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("course.session.table.session")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="150px"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("course.session.table.teacher")}
              </Table.ColumnHeader>
              {/* <Table.ColumnHeader w="100px" color="black" fontWeight="bold" fontSize="xs" textTransform="uppercase" letterSpacing="wider">{t("course.session.table.classroom")}</Table.ColumnHeader> */}

              <Table.ColumnHeader
                w="80px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("course.session.table.intra")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="80px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("course.session.table.final")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="90px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("course.session.table.participation")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="90px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("course.session.table.status")}
              </Table.ColumnHeader>
              <Table.ColumnHeader
                w="80px"
                textAlign="center"
                color="white"
                fontWeight="bold"
                fontSize="xs"
                textTransform="uppercase"
                letterSpacing="wider"
              >
                {t("course.session.table.actions")}
              </Table.ColumnHeader>
            </Table.Row>
          </Table.Header>

          <Table.Body>
            {sessions.map((session, _index) => (
              <Table.Row
                key={session.id}
                opacity={isPlaceholderData ? 0.5 : 1}
                _odd={{ bg: "#f7f9fc" }} _even={{ bg: "white" }} _hover={{ bg: "gray.100" }}
              >
                {/* Course Name */}
                <Table.Cell w="180px">
                  <HStack gap={1}>
                    <Icon as={FiBookOpen} boxSize={3} color="gray.400" />
                    <VStack align="start" gap={0}>
                      <Text
                        fontSize="sm"
                        fontWeight="600"
                        color="gray.800"
                        truncate
                        maxW="150px"
                      >
                        {session.course_program_level?.course?.name ||
                          t("common.tables.unknown")}
                      </Text>
                      <Text fontSize="xs" color="gray.500" fontFamily="mono">
                        {session.course_program_level?.course?.code || "N/A"}
                      </Text>
                    </VStack>
                  </HStack>
                </Table.Cell>

                {/* Program Level */}
                <Table.Cell w="150px">
                  <VStack align="start" gap={0}>
                    <Text
                      fontSize="xs"
                      fontWeight="500"
                      color="gray.700"
                      truncate
                      maxW="140px"
                    >
                      {session.course_program_level?.program_level?.name ||
                        t("common.tables.unknown")}
                    </Text>
                  </VStack>
                </Table.Cell>

                {/* Year Level */}
                <Table.Cell w="80px" textAlign="center">
                  <Badge
                    colorPalette={session.year_level ? "blue" : "gray"}
                    variant="outline"
                    size="xs"
                  >
                    {session.year_level
                      ? t("course.session.table.year_short", {
                        year: session.year_level,
                      })
                      : "-"}
                  </Badge>
                </Table.Cell>

                {/* Session */}
                <Table.Cell w="120px">
                  <HStack gap={1}>
                    <Icon as={FiClock} boxSize={3} color="gray.400" />
                    <Text
                      fontSize="xs"
                      fontWeight="500"
                      color="gray.700"
                      truncate
                      maxW="100px"
                    >
                      {session.session?.description ||
                        t("common.tables.unknown")}
                    </Text>
                  </HStack>
                </Table.Cell>

                {/* Teacher */}
                <Table.Cell w="150px">
                  <HStack gap={1}>
                    <Icon as={FiUser} boxSize={3} color="gray.400" />
                    <VStack align="start" gap={0}>
                      <Text
                        fontSize="xs"
                        fontWeight="500"
                        color="gray.700"
                        truncate
                        maxW="130px"
                      >
                        {session.teacher?.user?.first_name &&
                          session.teacher?.user?.last_name
                          ? `${session.teacher.user.first_name} ${session.teacher.user.last_name}`
                          : t("common.tables.unknown")}
                      </Text>
                      <Text fontSize="xs" color="gray.400">
                        {session.teacher?.user.user_number ||
                          t("common.tables.not_available")}
                      </Text>
                    </VStack>
                  </HStack>
                </Table.Cell>

                {/* Classroom */}
                {/* <Table.Cell w="100px">
                  <HStack gap={1}>
                    <Icon as={FiMapPin} boxSize={3} color="gray.400" />
                    <Text fontSize="xs" color="gray.700" truncate>
                      {session.classroom || "-"}
                    </Text>
                  </HStack>
                </Table.Cell> */}

                {/* Assessments */}
                <Table.Cell w="80px" textAlign="center">
                  <Text fontSize="sm" fontWeight="600" color="purple.600">
                    {session.intra_percentage ?? 0}%
                  </Text>
                </Table.Cell>

                <Table.Cell w="80px" textAlign="center">
                  <Text fontSize="sm" fontWeight="600" color="red.600">
                    {session.final_percentage ?? 0}%
                  </Text>
                </Table.Cell>

                <Table.Cell w="90px" textAlign="center">
                  <Text fontSize="sm" fontWeight="600" color="blue.600">
                    {session.participation_percentage ?? 0}%
                  </Text>
                </Table.Cell>

                {/* Status */}
                <Table.Cell w="90px" textAlign="center">
                  {session.is_active ? (
                    <Badge colorPalette="green" variant="surface" size="xs">
                      {t("course.session.table.active")}
                    </Badge>
                  ) : (
                    <Badge colorPalette="red" variant="surface" size="xs">
                      {t("course.session.table.inactive")}
                    </Badge>
                  )}
                </Table.Cell>

                {/* Actions */}
                <Table.Cell w="80px" textAlign="center">
                  <CourseSessionActionsMenu courseSession={session} />
                </Table.Cell>
              </Table.Row>
            ))}
          </Table.Body>
        </Table.Root>
      </Box>

      {/* Pagination - Always visible */}
      <Flex justify="space-between" align="center" mt={2} px={2}>
        <Text fontSize="xs" color="gray.500">
          {t("common.tables.showing", {
            first: (page - 1) * PER_PAGE + 1,
            last: Math.min(page * PER_PAGE, count),
            total: count,
            items: t("common.course_sessions").toLowerCase(),
          })}
        </Text>

        <PaginationRoot
          count={count}
          pageSize={PER_PAGE}
          page={page}
          onPageChange={({ page }) => setPage(page)}
        >
          <HStack gap={1}>
            <PaginationPrevTrigger />
            <PaginationItems />
            <PaginationNextTrigger />
          </HStack>
        </PaginationRoot>
      </Flex>
    </VStack>
  )
}

function CourseSessionPage() {
  const search = Route.useSearch()
  const [courseSearch, setCourseSearch] = useState(search.course_query || "")
  const [statusFilter, setStatusFilter] = useState(search.status || "")

  return (
    <Container maxW="full" py={8}>
      <CourseSessionHeader
        courseSearch={courseSearch}
        setCourseSearch={setCourseSearch}
        statusFilter={statusFilter}
        setStatusFilter={setStatusFilter}
      />
      <CourseSessionTable courseSearch={courseSearch} />
    </Container>
  )
}
