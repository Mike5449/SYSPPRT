import {
  Badge,
  Box,
  Container,
  Flex,
  HStack,
  Icon,
  IconButton,
  Spinner,
  Table,
  Text,
  VStack,
} from "@chakra-ui/react"
import { useQuery } from "@tanstack/react-query"
import { createFileRoute } from "@tanstack/react-router"
import { useEffect, useState } from "react"
import { useTranslation } from "react-i18next"
import {
  FiActivity,
  FiAlertCircle,
  FiCalendar,
  FiChevronDown,
  FiClock,
  FiHome,
  FiMapPin,
  FiRefreshCw,
  FiUser,
} from "react-icons/fi"
import { MenuContent, MenuItem, MenuRoot, MenuTrigger } from "@/components/ui/menu"
import { z } from "zod"

import {
  type SchedulePublicWithDetails,
  SchedulesService,
  StudentsService,
  TeachersService,
} from "@/client"
import { ScheduleActionsMenu } from "@/components/Common/ScheduleActionsMenu"
import AddSchedule from "@/components/schedule/AddSchedule"
import useAuth from "@/hooks/useAuth"

const scheduleSearchSchema = z.object({
  page: z.number().catch(1),
})

export const Route = createFileRoute("/_layout/schedule")({
  component: SchedulePage,
  validateSearch: (search) => scheduleSearchSchema.parse(search),
})

function SchedulePage() {
  const { t } = useTranslation()
  const { user: currentUser } = useAuth()

  const [yearLevel, setYearLevel] = useState("")
  const [sessionNumber, setSessionNumber] = useState("")
  const [programLevelId, setProgramLevelId] = useState<string | undefined>()
  const [teacherId, setTeacherId] = useState<string | undefined>()
  const [maxYearLevel, setMaxYearLevel] = useState(6)
  const [shouldFetch, setShouldFetch] = useState(false)

  const isSuperAdmin = currentUser?.is_superuser

  const { data: studentData } = useQuery({
    queryKey: ["student_by_user", currentUser?.id],
    queryFn: () => StudentsService.readStudentByUser({ userId: currentUser!.id }),
    enabled: !!currentUser && !isSuperAdmin,
  })

  const { data: teacherData } = useQuery({
    queryKey: ["teacher_by_user", currentUser?.id],
    queryFn: () => TeachersService.readTeacherByUser({ userId: currentUser!.id }),
    enabled: !!currentUser && !isSuperAdmin,
  })

  useEffect(() => {
    if (!studentData) return
    if (studentData.program_level?.id) {
      setProgramLevelId(studentData.program_level.id)
      setMaxYearLevel(studentData.program_level.typical_duration || 6)
    }
    if (studentData.current_year_level)
      setYearLevel(studentData.current_year_level.toString())
    setShouldFetch(true)
  }, [studentData])

  useEffect(() => {
    if (!teacherData?.id) return
    setTeacherId(teacherData.id)
    setShouldFetch(true)
  }, [teacherData])

  useEffect(() => {
    if (isSuperAdmin && !shouldFetch) setShouldFetch(true)
  }, [isSuperAdmin, shouldFetch])

  const { data, isLoading, error, refetch } = useQuery({
    queryKey: ["schedules-search", programLevelId, sessionNumber, yearLevel, teacherId],
    queryFn: () =>
      SchedulesService.searchSchedules({
        programLevelId: programLevelId || undefined,
        sessionNumber: sessionNumber ? parseInt(sessionNumber, 10) : undefined,
        yearLevel: yearLevel ? parseInt(yearLevel, 10) : undefined,
        teacherId: teacherId || undefined,
        skip: 0,
        limit: 1000,
      }),
    enabled: shouldFetch,
    retry: false,
  })

  const schedules = data?.data ?? []
  const yearLevels = Array.from({ length: maxYearLevel }, (_, i) => i + 1)

  const DAY_NAMES = [
    t("schedule.days.sunday"),
    t("schedule.days.monday"),
    t("schedule.days.tuesday"),
    t("schedule.days.wednesday"),
    t("schedule.days.thursday"),
    t("schedule.days.friday"),
    t("schedule.days.saturday"),
  ]

  const getWeekdayName = (d: number) => DAY_NAMES[d] || t("common.unknown")

  const formatTime = (str: string) => {
    const parts = str.split(":")
    return parts.length >= 2 ? `${parts[0]}:${parts[1]}` : str
  }

  const calcDuration = (start: string, end: string) => {
    try {
      const s = new Date(`1970-01-01T${start}`)
      const e = new Date(`1970-01-01T${end}`)
      const m = Math.floor((e.getTime() - s.getTime()) / 60000)
      const h = Math.floor(m / 60), min = m % 60
      return h > 0 ? `${h}h${min > 0 ? `${min}m` : ""}` : `${min}m`
    } catch { return "—" }
  }

  const DAY_ORDER = [1, 2, 3, 4, 5, 6, 0]
  const sortedSchedules = schedules.slice().sort((a, b) => {
    const dayDiff = DAY_ORDER.indexOf(a.day_of_week ?? 0) - DAY_ORDER.indexOf(b.day_of_week ?? 0)
    return dayDiff !== 0 ? dayDiff : a.start_time.localeCompare(b.start_time)
  })

  return (
    <Box minH="100vh" bg="gray.50" py={6}>
      <Container maxW="full">

        {/* ── Header ──────────────────────────────────────────────────── */}
        <Box mb={5}>
          <Flex justify="space-between" align="center" mb={3}>
            <Box>
              <Flex align="center" gap={2} mb="2px">
                <Icon as={FiCalendar} color="gray.600" fontSize="16px" />
                <Text fontSize="lg" fontWeight="700" color="gray.800" letterSpacing="-0.2px">
                  Emploi du Temps
                </Text>
              </Flex>
              <Text fontSize="xs" color="gray.400" pl="22px">
                {data
                  ? `${schedules.length} séance${schedules.length !== 1 ? "s" : ""}`
                  : t("schedule.description")}
              </Text>
            </Box>
            <HStack gap={2}>
              <IconButton variant="ghost" size="xs" color="#6b8ab0" onClick={() => { setShouldFetch(true); refetch() }} aria-label={t("common.tables.refresh")} _hover={{ color: "ui.main", bg: "transparent" }}>
                <FiRefreshCw />
              </IconButton>
              {isSuperAdmin && <AddSchedule />}
            </HStack>
          </Flex>
          <HStack bg="white" borderRadius="8px" p="0.35rem 1rem" boxShadow="0 2px 8px rgba(0,20,40,0.04)" border="1px solid #edf2f7" gap="10px" w="full" justify="flex-end">
            <MenuRoot positioning={{ gutter: 4, placement: "bottom-end" }}>
              <MenuTrigger asChild>
                <HStack cursor="pointer" color="#1f3b62" fontWeight="500" fontSize="0.75rem" _hover={{ color: "ui.main" }} gap="4px">
                  <Icon as={FiCalendar} color="#2a5f8a" boxSize={3} />
                  <Text>{yearLevel ? t("course.session.table.year_short", { year: yearLevel }) : t("common.forms.select")}</Text>
                  <Icon as={FiChevronDown} boxSize={2.5} color="#a0aec0" />
                </HStack>
              </MenuTrigger>
              <MenuContent minW="130px" bg="white" borderRadius="10px" border="1px solid #e2ecf9" p="4px" zIndex={1500}>
                <MenuItem value="" fontSize="0.75rem" borderRadius="6px" onClick={() => setYearLevel("")}>{t("common.forms.select")}</MenuItem>
                {yearLevels.map((lv) => (
                  <MenuItem key={lv} value={String(lv)} fontSize="0.75rem" borderRadius="6px" onClick={() => setYearLevel(String(lv))}>
                    {t("course.session.table.year_short", { year: lv })}
                  </MenuItem>
                ))}
              </MenuContent>
            </MenuRoot>
            <Box w="1px" h="10px" bg="gray.100" />
            <MenuRoot positioning={{ gutter: 4, placement: "bottom-end" }}>
              <MenuTrigger asChild>
                <HStack cursor="pointer" color="#1f3b62" fontWeight="500" fontSize="0.75rem" _hover={{ color: "ui.main" }} gap="4px">
                  <Icon as={FiActivity} color="#2a5f8a" boxSize={3} />
                  <Text>{sessionNumber === "1" ? t("schedule.fields.session_1") : sessionNumber === "2" ? t("schedule.fields.session_2") : t("schedule.fields.all_sessions")}</Text>
                  <Icon as={FiChevronDown} boxSize={2.5} color="#a0aec0" />
                </HStack>
              </MenuTrigger>
              <MenuContent minW="130px" bg="white" borderRadius="10px" border="1px solid #e2ecf9" p="4px" zIndex={1500}>
                <MenuItem value="" fontSize="0.75rem" borderRadius="6px" onClick={() => setSessionNumber("")}>{t("schedule.fields.all_sessions")}</MenuItem>
                <MenuItem value="1" fontSize="0.75rem" borderRadius="6px" onClick={() => setSessionNumber("1")}>{t("schedule.fields.session_1")}</MenuItem>
                <MenuItem value="2" fontSize="0.75rem" borderRadius="6px" onClick={() => setSessionNumber("2")}>{t("schedule.fields.session_2")}</MenuItem>
              </MenuContent>
            </MenuRoot>
          </HStack>
        </Box>

        {/* ── Error ───────────────────────────────────────────────────── */}
        {error && (
          <Flex align="center" gap={3} p={4} bg="red.50" border="1px solid"
            borderColor="red.200" borderRadius="8px" mb={4}>
            <Icon as={FiAlertCircle} color="red.500" />
            <Box>
              <Text fontWeight="600" fontSize="sm" color="red.700">{t("common.error")}</Text>
              <Text fontSize="xs" color="red.500">{(error as any).message}</Text>
            </Box>
          </Flex>
        )}

        {/* ── Loading ─────────────────────────────────────────────────── */}
        {isLoading && (
          <Flex justify="center" align="center" py={16} gap={3}>
            <Spinner size="sm" color="gray.400" />
            <Text color="gray.500" fontSize="sm">{t("common.loading")}…</Text>
          </Flex>
        )}

        {/* ── Empty ───────────────────────────────────────────────────── */}
        {!isLoading && shouldFetch && schedules.length === 0 && (
          <Flex direction="column" align="center" py={16} gap={3}
            bg="white" borderRadius="12px" border="1px solid" borderColor="gray.200">
            <Icon as={FiCalendar} fontSize="28px" color="gray.300" />
            <Box textAlign="center">
              <Text fontWeight="600" fontSize="sm" color="gray.500" mb={1}>
                {t("common.tables.no_results")}
              </Text>
              <Text fontSize="xs" color="gray.400">
                {t("schedule.no_results_description")}
              </Text>
            </Box>
          </Flex>
        )}

        {/* ── Table ───────────────────────────────────────────────────── */}
        {!isLoading && shouldFetch && schedules.length > 0 && (
          <Box
            bg="white"
            borderRadius="12px"
            border="1px solid"
            borderColor="gray.200"
            boxShadow="0 1px 6px -2px rgba(0,0,0,0.06)"
            overflow="hidden"
          >
            {/* Table top bar */}
            <Flex
              px={5} py={3}
              borderBottom="1px solid"
              borderColor="gray.100"
              align="center"
              justify="space-between"
              bg="gray.50"
            >
              <Text fontSize="11px" fontWeight="700" color="gray.500"
                textTransform="uppercase" letterSpacing="0.5px">
                Emploi du temps
              </Text>
              <Badge
                px={2} py="1px" borderRadius="4px"
                bg="gray.200" color="gray.600"
                fontSize="11px" fontWeight="600"
              >
                {schedules.length}
              </Badge>
            </Flex>

            <Box overflowX="auto">
              <Table.Root size="sm" stickyHeader minW="860px">
                <Table.Header>
                  <Table.Row background="linear-gradient(135deg, #2c5282 0%, #2b6cb0 100%)">
                    {[
                      { label: "Cours", w: "auto" },
                      { label: "Professeur", w: "160px" },
                      { label: "Jour", w: "110px" },
                      { label: "Horaire", w: "200px" },
                      { label: "Durée", w: "80px" },
                      { label: "Salle", w: "130px" },
                      ...(isSuperAdmin ? [{ label: "", w: "50px" }] : []),
                    ].map(({ label, w }) => (
                      <Table.ColumnHeader
                        key={label}
                        w={w}
                        fontSize="10.5px"
                        fontWeight="700"
                        color="white"
                        textTransform="uppercase"
                        letterSpacing="0.5px"
                        py={3}
                        borderBottom="1.5px solid"
                        borderColor="whiteAlpha.300"
                        pl={label === "Cours" ? 5 : undefined}
                        textAlign={
                          label === "Horaire" || label === "Durée"
                            ? "center"
                            : label === ""
                              ? "right"
                              : "left"
                        }
                      >
                        {label}
                      </Table.ColumnHeader>
                    ))}
                  </Table.Row>
                </Table.Header>

                <Table.Body>
                  {sortedSchedules.map((s: SchedulePublicWithDetails) => {
                    const courseName = s.course_session?.course_program_level?.course?.name || "—"
                    const courseCode = s.course_session?.course_program_level?.course?.code || "—"
                    const teacher = s.course_session?.teacher?.user
                      ? `${s.course_session.teacher.user.first_name} ${s.course_session.teacher.user.last_name}`
                      : "—"

                    return (
                      <Table.Row
                        key={s.id}
                        _odd={{ bg: "#f7f9fc" }} _even={{ bg: "white" }} _hover={{ bg: "gray.100" }}
                        transition="background 0.1s"
                        borderBottom="1px solid"
                        borderColor="gray.100"
                      >
                        {/* Cours */}
                        <Table.Cell py="11px" pl={5}>
                          <VStack align="start" gap="2px">
                            <Text fontSize="13px" fontWeight="600" color="gray.800" lineClamp={1}>
                              {courseName}
                            </Text>
                            <Box
                              display="inline-block"
                              px="5px" py="1px"
                              bg="gray.100"
                              borderRadius="3px"
                              border="1px solid"
                              borderColor="gray.200"
                            >
                              <Text fontSize="10px" fontFamily="mono" fontWeight="700" color="gray.600">
                                {courseCode}
                              </Text>
                            </Box>
                          </VStack>
                        </Table.Cell>

                        {/* Professeur */}
                        <Table.Cell py="11px">
                          <HStack gap={2}>
                            <Flex
                              w="24px" h="24px" borderRadius="full"
                              bg="gray.100" align="center" justify="center"
                              flexShrink={0}
                            >
                              <Icon as={FiUser} color="gray.400" fontSize="11px" />
                            </Flex>
                            <Text fontSize="12.5px" fontWeight="500" color="gray.700" lineClamp={1}>
                              {teacher}
                            </Text>
                          </HStack>
                        </Table.Cell>

                        {/* Jour — texte simple, sans couleur ni fond */}
                        <Table.Cell py="11px">
                          <Text fontSize="12.5px" fontWeight="500" color="gray.700">
                            {getWeekdayName(s.day_of_week ?? 0)}
                          </Text>
                        </Table.Cell>

                        {/* Horaire */}
                        <Table.Cell py="11px" textAlign="center">
                          <HStack gap={1} justify="center">
                            <Box
                              display="inline-flex" alignItems="center" gap="4px"
                              px="8px" py="3px"
                              bg="#f0fdf4" borderRadius="5px"
                              border="1px solid #bbf7d0"
                            >
                              <Icon as={FiClock} fontSize="10px" color="#15803d" />
                              <Text fontSize="12px" fontFamily="mono" fontWeight="700" color="#15803d">
                                {formatTime(s.start_time)}
                              </Text>
                            </Box>
                            <Text fontSize="10px" color="gray.300">→</Text>
                            <Box
                              display="inline-flex" alignItems="center" gap="4px"
                              px="8px" py="3px"
                              bg="#fff1f2" borderRadius="5px"
                              border="1px solid #fecdd3"
                            >
                              <Icon as={FiClock} fontSize="10px" color="#be123c" />
                              <Text fontSize="12px" fontFamily="mono" fontWeight="700" color="#be123c">
                                {formatTime(s.end_time)}
                              </Text>
                            </Box>
                          </HStack>
                        </Table.Cell>

                        {/* Durée */}
                        <Table.Cell py="11px" textAlign="center">
                          <Box
                            display="inline-block"
                            px="8px" py="2px"
                            bg="gray.100" borderRadius="5px"
                            border="1px solid" borderColor="gray.200"
                          >
                            <Text fontSize="11.5px" fontWeight="600" color="gray.600">
                              {calcDuration(s.start_time, s.end_time)}
                            </Text>
                          </Box>
                        </Table.Cell>

                        {/* Salle */}
                        <Table.Cell py="11px">
                          <VStack align="start" gap="1px">
                            <HStack gap={1}>
                              <Icon as={FiMapPin} fontSize="11px" color="gray.400" />
                              <Text fontSize="12px" fontWeight="600" color="gray.700">
                                {s.room || "—"}
                              </Text>
                            </HStack>
                            {s.building && (
                              <HStack gap={1}>
                                <Icon as={FiHome} fontSize="10px" color="gray.300" />
                                <Text fontSize="11px" color="gray.400">{s.building}</Text>
                              </HStack>
                            )}
                          </VStack>
                        </Table.Cell>

                        {/* Actions */}
                        {isSuperAdmin && (
                          <Table.Cell py="11px" textAlign="right" pr={4}>
                            <ScheduleActionsMenu schedule={s} />
                          </Table.Cell>
                        )}
                      </Table.Row>
                    )
                  })}
                </Table.Body>
              </Table.Root>
            </Box>
          </Box>
        )}
      </Container>
    </Box>
  )
}
